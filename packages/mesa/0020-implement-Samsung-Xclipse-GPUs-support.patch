+            h ^= blk.y * 0x85ebca6bu;
+            h ^= blk.z * 0xc2b2ae35u;
+            h ^= blk.w * 0x27d4eb2fu;
+            h ^= uint(idx) * 0x165667b1u;
+            h ^= h >> 15;
+            hist.bucket[BC_HASH_BASE + uint(pc.hash_slot) * 64u + uint(k)] = h;
+         }
+      }
+   }
