+   from_rev = ac_model_from_chip_rev(chip_rev);
+   model = from_rev;
+
+#ifdef __ANDROID__
+   if (__system_property_get("ro.soc.model", soc) > 0 && soc[0])
+      src = "ro.soc.model";
+#endif
