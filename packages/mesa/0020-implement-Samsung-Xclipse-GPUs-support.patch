+static unsigned
+radv_xclipse_size_bucket(uint64_t size)
+{
+   unsigned b = 0;
+   uint64_t lim = 16 * 1024;
+   while (b < 7 && size >= lim) {
+      lim *= 4;
+      b++;
+   }
+   return b;
