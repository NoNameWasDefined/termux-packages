+   if (soc[0]) {
+      enum ac_xclipse_model from_soc = AC_XCLIPSE_UNKNOWN;
+      if (!strcmp(soc, "s5e9925") || !strcmp(soc, "s5e9935"))
+         from_soc = AC_XCLIPSE_920;
+      else if (!strcmp(soc, "s5e8845"))
+         from_soc = AC_XCLIPSE_530;
