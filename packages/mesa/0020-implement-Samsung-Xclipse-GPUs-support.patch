+   ok &= ac_titan_check_space("ctx", AC_TITAN_CTX_DWORDS, ac_titan_ctx_dw, src_of,
+                              &moved_ctx, &warn_ctx);
+   ok &= ac_titan_check_space("sh", AC_TITAN_SH_DWORDS, ac_titan_sh_dw, src_of,
+                              &moved_sh, &warn_sh);
